<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>La Bonne Frite fast food</title>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700;800&display=swap" rel="stylesheet">
<style>
:root{--prune:#542D43;--rose:#D98BAA;--mauve:#86536A;--creme:#FFF0D9;--or:#F5B642;--bg:#FFF8EC;--card:#fff;--txt:#3a1f2e;--red:#c0392b}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]){--bg:#FFF8EC}}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{font-family:Nunito,ui-rounded,"Segoe UI",system-ui,sans-serif;background:var(--bg);color:var(--txt);display:flex;justify-content:center}
#app{width:100%;max-width:480px;height:100%;display:flex;flex-direction:column;background:var(--bg);position:relative}
header{background:var(--prune);color:var(--creme);padding:calc(10px + env(safe-area-inset-top,0px)) 16px 10px;display:flex;align-items:center;justify-content:space-between;font-weight:800;letter-spacing:.3px}
header .bell{background:none;border:0;font-size:22px;position:relative;cursor:pointer;color:var(--creme)}
header .bell b{position:absolute;top:-4px;right:-6px;background:var(--or);color:var(--prune);border-radius:10px;font-size:11px;padding:0 5px}
main{flex:1;overflow-y:auto;padding:16px}
h2{margin:4px 0 12px;color:var(--prune)}
.card{background:var(--card);border-radius:22px;padding:14px 16px;margin-bottom:12px;box-shadow:0 2px 10px #542d4318}
select,input{font:inherit;padding:10px 12px;border:2px solid var(--rose);border-radius:14px;background:#fff;width:100%;color:var(--txt)}
label{font-size:13px;font-weight:700;color:var(--mauve);display:block;margin:8px 0 3px}
.logo{display:block;margin:6px auto 10px;width:190px;height:190px;border-radius:50%;box-shadow:0 6px 18px #542d4333}
.center{text-align:center}
.slide{position:relative;height:68px;border-radius:40px;background:var(--creme);border:2px solid var(--rose);margin:10px 0;touch-action:none;user-select:none;overflow:hidden}
.slide span{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding-left:60px;font-weight:800;color:var(--mauve)}
.knob{position:absolute;left:4px;top:4px;width:56px;height:56px;border-radius:50%;background:var(--prune);color:var(--or);display:flex;align-items:center;justify-content:center;font-size:26px;font-weight:800;cursor:grab}
.slide.pause .knob{background:var(--or);color:var(--prune)}
.slide.off{opacity:.45;pointer-events:none}
.nav{display:flex;background:#fff;border-top:2px solid var(--creme);padding:6px 4px calc(6px + env(safe-area-inset-bottom,0px))}
.nav button{flex:1;border:0;background:none;font:inherit;font-size:12px;font-weight:700;color:var(--mauve);padding:6px 0;cursor:pointer;border-radius:16px}
.nav button i{display:block;font-style:normal;font-size:24px}
.nav button.on{color:var(--prune);background:var(--creme)}
.day{display:flex;justify-content:space-between;align-items:center;padding:9px 0;border-bottom:1px dashed var(--rose)}
.day:last-child{border:0}
.day b{color:var(--prune);width:44px}
.tag{background:var(--creme);border-radius:12px;padding:2px 10px;font-size:13px;font-weight:700;color:var(--mauve)}
.alert{border-left:6px solid var(--red);background:#fff4f2}
.ok{border-left:6px solid var(--or)}
.btn{background:var(--prune);color:var(--creme);border:0;border-radius:30px;padding:16px;width:100%;font:inherit;font-weight:800;font-size:16px;margin-top:8px;cursor:pointer}
.btn.alt{background:var(--rose);color:var(--prune)}
.avatar{width:110px;height:110px;border-radius:50%;margin:0 auto 8px;background:var(--rose);color:var(--prune);font-size:42px;font-weight:800;display:flex;align-items:center;justify-content:center;background-size:cover;background-position:center;border:4px solid var(--or)}
.pill{display:inline-block;background:var(--prune);color:var(--creme);border-radius:24px;padding:12px 18px;margin:4px;font-weight:800;font-size:20px}
.pill small{display:block;font-size:12px;color:var(--or)}
.legal p,.legal li{font-size:14px;line-height:1.45}
.big{font-size:30px;font-weight:800;color:var(--prune)}
</style>
</head>
<body>
<div id="app">
<header><span>🍟 La Bonne Frite</span><button class="bell" id="bell" aria-label="Alertes">🔔<b id="cnt"></b></button></header>
<main id="main"></main>
<nav class="nav" id="nav"></nav>
</div>
<script>
const LOGO="data:image/jpeg;base64,";
const J=["Lun","Mar","Mer","Jeu","Ven","Sam","Dim"];
const H=t=>{const[a,b]=t.split(":");return +a*60+ +b};
const f=x=>String(Math.floor(x/60)).padStart(2,"0")+":"+String(x%60).padStart(2,"0");
const hh=x=>Math.floor(x/60)+"h"+String(Math.round(x%60)).padStart(2,"0");
const DEMO=[
{id:1,nom:"Martin",prenom:"Léa",entree:"2024-03-04",poste:"Caisse",age:24},
{id:2,nom:"Durand",prenom:"Sam",entree:"2023-09-18",poste:"Friteuse",age:31},
{id:3,nom:"Petit",prenom:"Inès",entree:"2026-06-01",poste:"Préparation",age:17},
{id:4,nom:"Moreau",prenom:"Yanis",entree:"2025-01-13",poste:"Service en salle",age:22},
{id:5,nom:"Bernard",prenom:"Chloé",entree:"2025-07-07",poste:"Caisse",age:27},
{id:6,nom:"Roux",prenom:"Hugo",entree:"2022-11-21",poste:"Chef d’équipe",age:35}];
const S=(s,e,bs,be)=>({s:H(s),e:H(e),bs:bs?H(bs):null,be:be?H(be):null});
const P={};let E=[];
function demo(){E=DEMO.map(x=>({...x}));E.forEach((e,i)=>{P[e.id]=[S("10:00","18:00","13:00","13:30"),S("10:00","18:00","13:00","13:30"),null,S("11:00","19:00","14:00","14:30"),S("11:00","19:00","14:00","14:30"),S("11:00","17:00","14:00","14:30"),null]});
P[2][1]=S("09:00","17:00","12:00","12:15");        // pause trop courte
P[3]=[S("10:00","16:00","12:30","13:00"),null,S("10:00","16:00","12:30","13:00"),S("14:00","22:30","17:30","18:00"),S("10:00","16:00","12:30","13:00"),null,null]; // nuit mineur
}
const today=(new Date().getDay()+6)%7;
let user="patron",page="home",view="main",live={on:false,pause:false,done:false};
const who=()=>user==="patron"?null:E.find(e=>e.id==user);
const lim=e=>e.age<16?{d:420,r:840,n:1200,p:270,pm:30}:e.age<18?{d:480,r:720,n:1320,p:270,pm:30}:{d:600,r:660,n:null,p:361,pm:20};
const dur=s=>(s.e-s.s)-((s.bs!=null&&s.be!=null)?s.be-s.bs:0);
function check(e){const L=lim(e),r=[],p=P[e.id];let tot=0;
p.forEach((s,i)=>{if(!s)return;
 if(s.s==null||s.e==null){r.push(`${J[i]} : case vide, comptabilisation impossible`);return}
 const w=dur(s),pa=(s.bs!=null&&s.be!=null)?s.be-s.bs:0;tot+=w;
 if(w>L.d)r.push(`${J[i]} : ${hh(w)} de travail (maximum ${hh(L.d)})`);
 if(w>=L.p&&pa<L.pm)r.push(`${J[i]} : pause de ${pa} min (minimum ${L.pm} min requis)`);
 if(L.n&&(s.s<360||s.e>L.n))r.push(`${J[i]} : travail de nuit interdit (${f(s.s)}–${f(s.e)})`);
 const n=p[i+1];if(n&&n.s!=null&&(1440-s.e+n.s)<L.r)r.push(`${J[i]}→${J[i+1]} : repos de ${hh(1440-s.e+n.s)} (minimum ${hh(L.r)})`)});
if(tot>2100)r.push(`Semaine : ${hh(tot)} (maximum 35h)`);
if(e.age<18){const d=p.map(x=>!x);if(!(d[6]&&(d[5]||d[0])))r.push("Repos hebdomadaire : 2 jours consécutifs incluant le dimanche requis")}
else if(!p.some(x=>!x))r.push("Repos hebdomadaire : 24 h consécutives minimum requises");
return r}
const alerts=()=>E.filter(e=>user==="patron"||e.id==user).flatMap(e=>check(e).map(t=>({n:`${e.prenom} ${e.nom}`,t})));
const tot=e=>{let w=0,b=0;P[e.id].forEach(s=>{if(s&&s.s!=null&&s.e!=null){w+=dur(s);if(s.bs!=null&&s.be!=null)b+=s.be-s.bs}});return[w,b]};
const nav=[["home","🏠","Accueil"],["plan","📅","Planning"],["alert","🔔","Alertes"],["prof","👤","Profil"]];
function drawNav(){document.getElementById("nav").innerHTML=nav.map(n=>`<button class="${page===n[0]?"on":""}" onclick="go('${n[0]}')"><i>${n[1]}</i>${n[2]}</button>`).join("");
const c=alerts().length;const el=document.getElementById("cnt");el.textContent=c||"";el.style.display=c?"":"none"}
function go(p){page=p;view="main";render()}
document.getElementById("bell").onclick=()=>go("alert");
function userSel(){return `<label>Connecté en tant que</label><select onchange="user=this.value==='patron'?'patron':+this.value;live={on:false,pause:false,done:false};render()"><option value="patron" ${user==="patron"?"selected":""}>Patron (supervision)</option>${E.map(e=>`<option value="${e.id}" ${e.id==user?"selected":""}>${e.prenom} ${e.nom}</option>`).join("")}</select>`}
function slider(id,label,cls,cb,off){return `<div class="slide ${cls} ${off?"off":""}" id="${id}"><span>${label}</span><div class="knob">›</div></div>`}
function bindSlide(id,cb){const s=document.getElementById(id);if(!s)return;const k=s.querySelector(".knob");let d=false,x0=0;
k.onpointerdown=e=>{d=true;x0=e.clientX;k.setPointerCapture(e.pointerId)};
k.onpointermove=e=>{if(!d)return;const m=s.clientWidth-64;k.style.left=Math.max(4,Math.min(m,4+e.clientX-x0))+"px"};
k.onpointerup=()=>{if(!d)return;d=false;const m=s.clientWidth-64;if(parseFloat(k.style.left)>m*.8)cb();else k.style.left="4px"}}
const now=()=>{const d=new Date();return d.getHours()*60+d.getMinutes()};
function ensure(e){if(!P[e.id][today])P[e.id][today]={s:null,e:null,bs:null,be:null};return P[e.id][today]}
function act(k){const e=who();if(!e)return;const s=ensure(e),t=now();
if(k==="start"){s.s=t;live.on=true;live.done=false}
if(k==="end"){s.e=t;live.on=false;live.pause=false;live.done=true;const a=check(e);if(a.length)alert("⚠️ Alerte envoyée au patron et à "+e.prenom+" :\n"+a.join("\n"))}
if(k==="bstart"){s.bs=t;live.pause=true}
if(k==="bend"){s.be=t;live.pause=false}
render()}
function home(){const e=who(),p=e&&P[e.id][today];
let h=`<img class="logo" src="${LOGO}" alt="Logo La Bonne Frite">${userSel()}`;
if(!e)return h+`<div class="card center" style="margin-top:12px">Mode patron : consultez le planning et les alertes de vos 6 équipiers. Le pointage est réservé aux employés.</div>`;
h+=`<div class="card"><b>Horaire de la journée (${J[today]})</b><br>${p&&p.s!=null?`${f(p.s)} → ${p.e!=null?f(p.e):"…"}`:"Pas de service prévu"}${p&&p.bs!=null?`<br>Pause : ${f(p.bs)} → ${p.be!=null?f(p.be):"…"}`:""}</div>`;
if(live.done)return h+`<div class="card center big">À demain ! 👋</div>`;
h+=!live.on?slider("sv","Glissez : début de service","",0):slider("sv","Glissez : fin de service","",0);
h+=slider("pv",live.pause?"Glissez : fin de pause":"Glissez : début de pause","pause",0,!live.on);
return h}
function plan(){const list=user==="patron"?E:[who()];
return `<h2>Planning de la semaine</h2>`+(list.length?"":"<div class=\"card\">Aucun employé inscrit : le patron les inscrit depuis l’onglet Profil.</div>")+list.map(e=>`<div class="card"><b>${e.prenom} ${e.nom}</b> <span class="tag">${e.poste}</span>${P[e.id].map((s,i)=>`<div class="day"><b>${J[i]}</b><span>${!s?'<span class="tag">Repos</span>':s.s==null||s.e==null?"…":`${f(s.s)}–${f(s.e)}${s.bs!=null&&s.be!=null?` <span class="tag">pause ${f(s.bs)}</span>`:""}`}</span></div>`).join("")}</div>`).join("")}
function alertPage(){const a=alerts(),e=who();
let h=`<h2>Alertes</h2><h3 style="color:var(--mauve)">Horaire impossible</h3>`;
h+=a.length?a.map(x=>`<div class="card alert"><b>${x.n}</b><br>${x.t}</div>`).join(""):`<div class="card ok">Aucun horaire impossible 🎉</div>`;
if(e){const p=P[e.id][today];h+=`<h3 style="color:var(--mauve)">Notifications</h3>`;
if(p&&p.be!=null||p&&p.bs!=null)h+=`<div class="card ok">Reprise de service à <b>${p.be!=null?f(p.be):"…"}</b></div>`;
if(p&&p.e!=null)h+=`<div class="card ok">Fin de service à <b>${f(p.e)}</b></div>`;
h+=`<h3 style="color:var(--mauve)">Les deux jours suivants</h3>`;
[1,2].forEach(k=>{const i=(today+k)%7,s=P[e.id][i];h+=`<div class="card ok"><b>${J[i]}</b> : ${s&&s.s!=null?f(s.s)+" – "+f(s.e):"Repos"}</div>`})}
return h}
function prof(){const e=who();if(!e)return `<h2>Profil du patron</h2>${userSel()}${team()}<button class="btn alt" onclick="view='legal';render()">Mentions légales</button>`;
const[w,b]=tot(e);
return `<h2>Profil</h2>${userSel()}<div style="margin-top:12px" class="center"><div class="avatar" id="av" style="${e.photo?`background-image:url(${e.photo})`:""}">${e.photo?"":e.prenom[0]+e.nom[0]}</div>
<label style="cursor:pointer" class="tag">📷 Photo professionnelle (facultative)<input type="file" accept="image/*" style="display:none" onchange="ph(this)"></label></div>
<div class="card"><label>Nom</label><input value="${e.nom}" onchange="up('nom',this.value)"><label>Prénom</label><input value="${e.prenom}" onchange="up('prenom',this.value)"><label>Date d’entrée (remplie par le patron)</label><input value="${new Date(e.entree).toLocaleDateString("fr-FR")}" disabled><label>Poste occupé</label><input value="${e.poste}" onchange="up('poste',this.value)"></div>
<div class="center"><span class="pill"><small>Heures de service</small>${hh(w)}</span><span class="pill"><small>Heures de pause</small>${hh(b)}</span></div>
<button class="btn alt" onclick="view='legal';render()">Mentions légales</button>`}
function team(){return `<div class="card" style="margin-top:12px"><b>Mon équipe (${E.length}/6)</b>${E.map(x=>`<div class="day"><span>${x.prenom} ${x.nom} <span class="tag">${x.age} ans</span></span><button class="tag" style="border:0;cursor:pointer" onclick="del(${x.id})">Retirer</button></div>`).join("")||"<p>Aucun employé inscrit pour le moment.</p>"}</div>`+(E.length<6?`<div class="card"><b>Inscrire un employé</b><label>Prénom</label><input id="n_p"><label>Nom</label><input id="n_n"><label>Âge</label><input id="n_a" type="number" min="14" max="99"><label>Date d’entrée dans l’entreprise</label><input id="n_d" type="date"><label>Poste (facultatif, l’employé pourra le modifier)</label><input id="n_o"><button class="btn" onclick="add()">Inscrire l’employé</button></div>`:`<div class="card">L’équipe est complète (6 équipiers).</div>`)+`<button class="btn alt" style="margin-bottom:8px" onclick="demo();render()">Charger l’exemple de démonstration</button>`}
function add(){const v=i=>document.getElementById(i).value.trim();if(!v("n_p")||!v("n_n")||!v("n_a")||!v("n_d")){alert("Merci de renseigner prénom, nom, âge et date d’entrée.");return}
const id=Math.max(0,...E.map(x=>x.id))+1;E.push({id,prenom:v("n_p"),nom:v("n_n"),age:+v("n_a"),entree:v("n_d"),poste:v("n_o")||"À renseigner"});P[id]=Array(7).fill(null);render()}
function del(id){if(!confirm("Retirer cet employé ?"))return;E=E.filter(x=>x.id!=id);delete P[id];if(user==id)user="patron";render()}
function up(k,v){who()[k]=v}
function ph(i){const r=new FileReader();r.onload=()=>{who().photo=r.result;render()};if(i.files[0])r.readAsDataURL(i.files[0])}
function legal(){return `<div class="legal"><button class="btn alt" style="margin:0 0 10px" onclick="view='main';render()">← Retour au profil</button><h2>Mentions légales</h2>
<div class="card"><p><b>Nom de l’application :</b> La Bonne Frite fast food</p><p><b>Éditrices :</b> Juliette V. et Louise S., classe de 1re STMG, lycée.</p><p><b>Hébergeur :</b> GitHub Pages.</p>
<p><b>Sources des données :</b> Code du travail et service-public.fr (consultés en novembre 2026).</p>
<p><b>Avertissement :</b> simulation pédagogique : les résultats sont indicatifs et ne remplacent pas l’avis d’un professionnel.</p>
<p>Aucune donnée personnelle n’est collectée ni enregistrée, aucun cookie n’est utilisé.</p>
<p><b>Crédits :</b> logo « La Bonne Frite » créé pour ce projet ; icônes : émojis du système ; police : Nunito (Google Fonts, licence SIL OFL). Les noms des équipiers affichés sont fictifs.</p></div></div>`}
function render(){const m=document.getElementById("main");
m.innerHTML=view==="legal"?legal():{home,plan,alert:alertPage,prof}[page]();
if(page==="home"&&view==="main"){bindSlide("sv",()=>act(live.on?"end":"start"));bindSlide("pv",()=>act(live.pause?"bend":"bstart"))}
drawNav();m.scrollTop=0}
render();
</script>
</body>
</html>
